{
  "manifest_version": 3,
  "name": "Lark クイック送信",
  "version": "1.4.0",
  "description": "選択したテキスト・リンク・画像・ページURLを、右クリックメニューから登録済みのLarkチャットへ直接送信します。",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://open.larksuite.com/*",
    "https://open.feishu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Lark クイック送信の設定",
    "default_popup": "options.html"
  }
}
